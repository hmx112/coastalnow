# Set only when you have deployed the separate Oneul Bada Cloudflare Worker.
# HTTPS only. Example: https://oneul-bada-api.your-account.workers.dev
# Do NOT put any KHOA credentials here; only on Cloudflare Worker Secrets.
VITE_TIDE_API_BASE_URL=

# Ads: release builds need the live group IDs from the Apps in Toss console.
# The explicit test build is: npm.cmd run build:adtest (NEVER publish that bundle).
# Do not put KHOA API keys in VITE_ variables; only the public ad group IDs go here.
VITE_BANNER_AD_GROUP_ID=
VITE_REWARDED_AD_GROUP_ID=
